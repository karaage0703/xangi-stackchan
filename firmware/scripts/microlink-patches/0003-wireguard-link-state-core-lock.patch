+static void wireguardif_set_link_state(struct netif *netif, bool up) {
+	if (sys_thread_tcpip(LWIP_CORE_LOCK_QUERY_HOLDER)) {
+		if (up) netif_set_link_up(netif);
+		else netif_set_link_down(netif);
+		return;
+	}
+	LOCK_TCPIP_CORE();
+	if (up) netif_set_link_up(netif);
+	else netif_set_link_down(netif);
+	UNLOCK_TCPIP_CORE();
+}
 
